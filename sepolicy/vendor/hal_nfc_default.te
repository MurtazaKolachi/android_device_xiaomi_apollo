# Data file accesses.
allow hal_nfc_default vendor_nfc_vendor_data_file:dir create_dir_perms;
allow hal_nfc_default vendor_nfc_vendor_data_file:file create_file_perms;

# Allow NFC HAL to read and open files in /vendor (like libraries).
allow hal_nfc_default vendor_file:dir { search };
allow hal_nfc_default vendor_file:file { read open };

# Fix for the SIGABRT crash in phNxpNciHal_write_unlocked
allow hal_nfc_default nfc_device:chr_file rw_file_perms;
